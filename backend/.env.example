# Server Configuration
PORT=8000
NODE_ENV=development

# Database Configuration
# Replace with your local MongoDB URI or MongoDB Atlas connection string
dbUrl=mongodb+srv://<username>:<password>@cluster.mongodb.net/shopkart

# Authentication Secrets
# Generate a strong, random string to use as the JWT secret
JWT_SECRET=your_super_secret_jwt_key_here


RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret


CLOUDINARY_CLOUD_NAME=name 
CLOUDINARY_API_KEY=key
CLOUDINARY_API_SECRET=CLOUDINARY_API_SECRET

# Admin Access Configuration (comma-separated if multiple)
ADMIN_EMAIL=admin@shopkart.com
ADMIN_KEY=your_secret_admin_passkey_here